
% initial facts, these do not change
% cell(X, Y). % represents a grid cell
% myId(ID). % the agent's own ID
% gridSize(Width, Height).
% bombRange(3). % bomb explosion propagation range

% facts modeling the game state at the beginning of the turn
% box(X, Y). % a box placed on the grid
% player(ID, X, Y, BombsLeft). % a player on the grid, BombsLeft is either 0 or 1

% bomb(OwnerID, X, Y, TurnsLeft). % a bomb on the grid, TurnsLeft is the detonation timer

maxHittableBoxes(4). % one for each direction
bombLifetime(8). % turns

currentPosition(X, Y) :- myId(Id), player(Id, X, Y, _).
timeToNextBomb(Remaining) :- myId(Id), bomb(Id, _, _, ElapsedTime), bombLifetime(N), Remaining = N - ElapsedTime.

% 13 * 11 * 2 = 286 initial answer sets
{ move(X, Y) : cell(X, Y); placeBomb(X, Y) : cell(X, Y) } = 1.

% rename to destination
destination(X, Y) :- move(X, Y).
destination(X, Y) :- placeBomb(X, Y).

:- move(X, Y), box(X, Y).
:- placeBomb(X, Y), box(X, Y).
:- destination(X, Y), bomb(_, X, Y, _). % it's all going to blow up anyway

% cell(X, Y) and cell(X1, Y1) are either on the same row or on the same column
inLine(X, Y, X1, Y1) :- cell(X, Y), cell(X1, Y1), X = X1.
inLine(X, Y, X1, Y1) :- cell(X, Y), cell(X1, Y1), Y = Y1.

% Whether a bomb at (Bx, By) will hit the cell at (X, Y)
bombAtCellHitsCell(Bx, By, X, Y) :- cell(Bx, By), cell(X, Y),
                                    inLine(Bx, By, X, Y), bombRange(Range),
                                    &abs(Bx - X; Dx), Dx < Range,
                                    &abs(By - Y; Dy), Dy < Range.

% A box being threatened by a bomb
threatenedBox(X, Y) :- box(X, Y), bomb(_, Bx, By, _), bombAtCellHitsCell(Bx, By, X, Y).
threatenedBoxByMe(X, Y) :- box(X, Y), bomb(Owner, Bx, By, _), bombAtCellHitsCell(Bx, By, X, Y), myId(Owner).

% how many boxes will be hit by a bomb placed at cell(X, Y)
hittableBoxes(X, Y, N) :- cell(X, Y), not box(X, Y),
                        N = #count { BoxX, BoxY : box(BoxX, BoxY),
                                            bombAtCellHitsCell(X, Y, BoxX, BoxY),
                                            not threatenedBoxByMe(BoxX, BoxY) }.

boxesHit(X, Y, N) :- cell(X, Y), not box(X, Y),
                        N = #count { BoxX, BoxY : box(BoxX, BoxY),
                                            bombAtCellHitsCell(X, Y, BoxX, BoxY),
                                            not threatenedBox(BoxX, BoxY) }.

% maximize number of boxes hit
:~ destination(X, Y), boxesHit(X, Y, N), maxHittableBoxes(Max). [Max - N@4]

destinationReached :- prevDestination(X, Y), currentPosition(X, Y).
bombPlaced :- placeBomb(_, _).
:- destinationReached, not bombPlaced.
:- not destinationReached, bombPlaced.

haveBomb :- myId(Id), player(Id, _, _, 1).
% haveBomb :- myId(Id), bomb(Id, _, _, 1).

% se il nemico ha piazzato una bomba
enemyBombPlanted(EnemyId, TimeLeft) :- myId(Id), bomb(EnemyId, _, _, TimeLeft), Id != EnemyId.
% che sta colpendo queste celle
interestingCells(Cx, Cy) :- bombAtCellHitsCell(X, Y, Cx, Cy), bomb(EnemyId, X, Y, _), enemyBombPlanted(EnemyId, _).
%:- interestingCells(X, Y), bomb(EnemyId, X, Y, _), enemyBombPlanted(EnemyId, _).
% e noi possiamo arrivare in queste celle prima che la bomba nemica esploda
reachableInterestingCells(Ix, Iy, Distance) :- currentPosition(X, Y), interestingCells(Ix, Iy), enemyBombPlanted(EnemyId, TimeLeft),
                            &abs(X - Ix; Dx),
                            &abs(Y - Iy; Dy),
                            Distance = Dx + Dy,
                            TimeLeft > Distance.

% per ogni cella raggiungibile, controlliamo se ci sono delle box che possiamo far esplodere
usefulReachableCells(Ix, Iy, Distance, N) :- reachableInterestingCells(Ix, Iy, Distance), hittableBoxes(Ix, Iy, N), N > 0.


% se abbiamo una bomba o la avremo quando arriveremo in quella cella
futureBombAvailability :- haveBomb.
futureBombAvailability :- usefulReachableCells(Ix, Iy, Distance, _), timeToNextBomb(N), Distance >= N.
% diamo priorità a questa posizione
:~ destination(X, Y), usefulReachableCells(X, Y, _, _), futureBombAvailability. [1@3]

:- usefulReachableCells(X, Y, _, N), destination(X, Y), N < 1.

:- prevDestination(X, Y), currentPosition(X, Y), haveBomb, placeBomb(X, Y).
:- destinationReached, move(_, _).

:~ currentPosition(SrcX, SrcY), destination(DstX, DstY),
    &abs(SrcX - DstX; Dx), &abs(SrcY - DstY; Dy). [Dx + Dy@2]

